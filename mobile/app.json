{
  "expo": {
    "name": "Sona",
    "slug": "sona",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sona",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1cb0f6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sona.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sona uses the microphone so your child can practice saying speech sounds.",
        "NSSpeechRecognitionUsageDescription": "Sona uses speech recognition to check how your child says each sound."
      }
    },
    "android": {
      "package": "com.sona.app",
      "permissions": ["RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1cb0f6"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
